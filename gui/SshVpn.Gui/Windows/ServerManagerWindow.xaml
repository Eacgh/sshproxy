<Window x:Class="SshVpn.Gui.Windows.ServerManagerWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务器管理"
        Width="560"
        Height="420"
        MinWidth="480"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="服务器列表" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

        <ListBox x:Name="ServerList" Grid.Row="1" Margin="0,0,0,12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ServerAddress}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="添加" Style="{StaticResource SecondaryButton}" MinWidth="80" Margin="0,0,8,0" Click="AddButton_Click" />
            <Button Content="编辑" Style="{StaticResource SecondaryButton}" MinWidth="80" Margin="0,0,8,0" Click="EditButton_Click" />
            <Button Content="删除" Style="{StaticResource SecondaryButton}" MinWidth="80" Margin="0,0,16,0" Click="DeleteButton_Click" />
            <Button Content="关闭" Style="{StaticResource PrimaryButton}" MinWidth="80" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
