<Window x:Class="SshVpn.Gui.Windows.ServerEditWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑服务器"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" VerticalAlignment="Center" Margin="0,0,0,10" />
        <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="服务器地址" VerticalAlignment="Center" Margin="0,0,0,10" />
        <TextBox x:Name="ServerAddressBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" ToolTip="域名、IP 或 主机:端口" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="用户名" VerticalAlignment="Center" Margin="0,0,0,10" />
        <TextBox x:Name="UsernameBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="密码" VerticalAlignment="Center" Margin="0,0,0,10" />
        <PasswordBox x:Name="PasswordInput" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="代理端口" VerticalAlignment="Center" Margin="0,0,0,10" />
        <TextBox x:Name="ProxyPortBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Text="1080" MaxLength="5" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="DNS（可选）" VerticalAlignment="Center" Margin="0,0,0,14" />
        <TextBox x:Name="DnsServerBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,14" ToolTip="留空使用系统 DNS；也可填写 DNS IP 或 IP:端口" />

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" MinWidth="80" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True" />
            <Button Content="确定" Style="{StaticResource PrimaryButton}" MinWidth="80" Click="OkButton_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
